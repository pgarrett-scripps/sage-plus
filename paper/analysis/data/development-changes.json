  "changes": [
    {
      "area": "Input",
      "upstream": "mzML, MGF, and Bruker readers",
      "plus": "mzMLb, Thermo RAW, peptide and cleavage inputs",
      "motivation": "Broader data and digestion workflows",
      "expected": "Fewer conversions, new input contracts"
    },
    {
      "area": "Output",
      "upstream": "TSV and optional Parquet, wide LFQ tables",
      "plus": "Typed Parquet, coordinates, long LFQ with nulls",
      "motivation": "Explicit identities and missing signals",
      "expected": "Typed joins, revised consuming scripts"
    },
    {
      "area": "Storage",
      "upstream": "Peptide arrays and dense modification vectors",
      "plus": "Protein spans and compact search structures",
      "motivation": "Reduce allocation and record size",
      "expected": "Lower memory with possible access costs"
    },
    {
      "area": "Execution",
      "upstream": "CLI searching and file batching",
      "plus": "Memory guards, API, events, isolated jobs",
      "motivation": "Bound resources and expose run state",
      "expected": "Early rejection, inspectable failures"
    },
    {
      "area": "Modeling",
      "upstream": "Isotope processing and linear prediction",
      "plus": "Scored envelopes, mass alignment, richer models",
      "motivation": "Represent candidate evidence more fully",
      "expected": "Changed scores and acceptance thresholds"
    },
    {
      "area": "PTM",
      "upstream": "Mass-based static and variable modifications",
      "plus": "PTM names, caps, neutral losses, site reports",
      "motivation": "Explicit hypotheses and site ambiguity",
      "expected": "Bounded variants, new confidence endpoints"
    },
    {
      "area": "Quantification",
      "upstream": "LFQ tracing and reporter-ion quantification",
      "plus": "Label channels, tracing controls, library export",
      "motivation": "Extend quantification and result reuse",
      "expected": "More options, distinct validation needs"
    }
  ]
}
