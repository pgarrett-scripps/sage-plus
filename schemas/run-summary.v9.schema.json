{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/pgarrett-scripps/sage-plus/main/schemas/run-summary.v9.schema.json",
  "title": "Sage run-summary.json (schema_version 9)",
  "description": "Portable statistics of one completed search. Objects allow additional properties: new optional fields may be added without a schema_version bump, so readers must ignore unknown keys.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "description": "Run-summary schema version. Fields added without a version bump are optional.",
      "minimum": 1,
      "const": 9
    },
    "runtime_secs": {
      "type": "integer",
      "description": "Wall-clock runtime of the search, in seconds.",
      "minimum": 0
    },
    "files": {
      "type": "integer",
      "description": "Spectrum files searched.",
      "minimum": 0
    },
    "peptides_in_database": {
      "type": "integer",
      "minimum": 0
    },
    "fragments_in_database": {
      "type": "integer",
      "minimum": 0
    },
    "psms_at_one_percent_fdr": {
      "type": "integer",
      "minimum": 0
    },
    "peptides_at_one_percent_fdr": {
      "type": "integer",
      "minimum": 0
    },
    "proteins_at_one_percent_fdr": {
      "type": "integer",
      "minimum": 0
    },
    "protein_groups_at_one_percent_fdr": {
      "type": "integer",
      "minimum": 0
    },
    "ptm_localization": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "localized_psms": {
          "type": "integer",
          "minimum": 0
        },
        "psm_q_value": {
          "type": "number"
        },
        "localization_q_value": {
          "type": "number"
        },
        "min_separating_margin": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "enabled",
        "localized_psms",
        "psm_q_value",
        "localization_q_value"
      ]
    },
    "models": {
      "type": "object",
      "properties": {
        "mass_alignment_applied": {
          "type": "boolean"
        },
        "mass_alignment_files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file_id": {
                "type": "integer",
                "minimum": 0
              },
              "calibration_psms": {
                "type": "integer",
                "minimum": 0
              },
              "precursor": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "fragment": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "precursor_skip_reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "fragment_skip_reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "file_id",
              "calibration_psms",
              "precursor",
              "fragment",
              "precursor_skip_reason",
              "fragment_skip_reason"
            ]
          }
        },
        "mass_recalibration": {
          "type": "object",
          "description": "Search-time mass recalibration; absent when mass_recalibration is off.",
          "properties": {
            "mode": {
              "type": "string",
              "description": "static, linear, or auto."
            },
            "files": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "required": [
            "mode",
            "files"
          ]
        },
        "retention_time_prediction_enabled": {
          "type": "boolean"
        },
        "retention_time_model_fitted": {
          "type": "boolean"
        },
        "retention_time_features": {
          "type": "string"
        },
        "retention_time_alignment": {
          "type": [
            "string",
            "null"
          ]
        },
        "ion_mobility_observed": {
          "type": "boolean"
        },
        "ion_mobility_model_enabled": {
          "type": "boolean"
        },
        "ion_mobility_model_fitted": {
          "type": "boolean"
        },
        "ion_mobility_features": {
          "type": "string"
        },
        "ion_mobility_scale": {
          "type": "string",
          "description": "calibrated, linear, or mixed; absent when no Bruker input was searched."
        }
      },
      "required": [
        "mass_alignment_applied",
        "retention_time_prediction_enabled",
        "retention_time_model_fitted",
        "retention_time_features",
        "retention_time_alignment",
        "ion_mobility_observed",
        "ion_mobility_model_enabled",
        "ion_mobility_model_fitted",
        "ion_mobility_features"
      ]
    },
    "quantification": {
      "type": "object",
      "properties": {
        "lfq_enabled": {
          "type": "boolean"
        },
        "lfq_features": {
          "type": "integer",
          "minimum": 0
        },
        "tmt": {
          "type": [
            "string",
            "null"
          ]
        },
        "tmt_features": {
          "type": "integer",
          "minimum": 0
        },
        "ms1_label_channels": {
          "type": "integer",
          "minimum": 0
        },
        "ms1_label_reference": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "lfq_enabled",
        "lfq_features",
        "tmt",
        "tmt_features"
      ]
    },
    "execution": {
      "type": "object",
      "properties": {
        "batch_size": {
          "type": "integer",
          "description": "Files loaded and searched at once.",
          "minimum": 0
        },
        "parallelism": {
          "type": "integer",
          "description": "Fallback file batch size; describes file batching, not threads.",
          "minimum": 0
        },
        "rayon_threads": {
          "type": "integer",
          "description": "Effective worker thread count (--threads, then threads, then RAYON_NUM_THREADS, then all cores).",
          "minimum": 0
        },
        "max_memory_gb": {
          "type": [
            "number",
            "null"
          ],
          "description": "Enforced memory limit in GiB; null when disabled."
        }
      },
      "required": [
        "batch_size",
        "parallelism",
        "max_memory_gb"
      ]
    },
    "inputs": {
      "type": "object",
      "properties": {
        "mzml_files": {
          "type": "integer",
          "minimum": 0
        },
        "thermo_raw_files": {
          "type": "integer",
          "minimum": 0
        },
        "other_files": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "mzml_files",
        "thermo_raw_files",
        "other_files"
      ]
    },
    "modifications": {
      "type": "object",
      "properties": {
        "static_definitions": {
          "type": "integer",
          "minimum": 0
        },
        "variable_definitions": {
          "type": "integer",
          "minimum": 0
        },
        "max_variable_mods": {
          "type": "integer",
          "minimum": 0
        },
        "max_total_variable_mods": {
          "type": "integer",
          "minimum": 0
        },
        "max_combinations": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "ptm_library_sites": {
          "type": "integer",
          "minimum": 0
        },
        "label_channels": {
          "type": "integer",
          "minimum": 0
        },
        "labeled_peptides": {
          "type": "integer",
          "minimum": 0
        },
        "mass_offset_definitions": {
          "type": "integer",
          "minimum": 0
        },
        "mass_offset_psms": {
          "type": "integer",
          "minimum": 0
        },
        "mass_offset_peptidoforms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "static_definitions",
        "variable_definitions",
        "max_variable_mods",
        "max_total_variable_mods",
        "max_combinations",
        "ptm_library_sites"
      ]
    },
    "spectral_library": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "entries": {
          "type": "integer",
          "minimum": 0
        },
        "transitions": {
          "type": "integer",
          "minimum": 0
        },
        "strategy": {
          "type": "string"
        },
        "psm_q_value": {
          "type": "number"
        },
        "peptide_q_value": {
          "type": "number"
        },
        "formats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "enabled",
        "entries",
        "transitions",
        "strategy",
        "psm_q_value",
        "peptide_q_value",
        "formats"
      ]
    },
    "qc": {
      "type": "object",
      "properties": {
        "digestion": {
          "type": "object",
          "description": "Same rows as digestion.tsv.",
          "properties": {
            "q_value": {
              "type": "number"
            },
            "files": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/DigestionFileStats"
              }
            },
            "total": {
              "$ref": "#/$defs/DigestionSummary"
            }
          },
          "required": [
            "q_value",
            "files",
            "total"
          ]
        },
        "polymers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string"
              },
              "ms1_spectra": {
                "type": "integer",
                "minimum": 0
              },
              "skipped_profile_spectra": {
                "type": "integer",
                "minimum": 0
              },
              "total_ion_current": {
                "type": "number"
              },
              "polymers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "intensity": {
                      "type": "number"
                    },
                    "tic_pct": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "name",
                    "intensity",
                    "tic_pct"
                  ]
                }
              }
            },
            "required": [
              "file",
              "ms1_spectra",
              "skipped_profile_spectra",
              "total_ion_current",
              "polymers"
            ]
          }
        },
        "diagnostic_ions": {
          "type": "object",
          "description": "Present when diagnostic_ions is enabled.",
          "properties": {
            "ms2_spectra": {
              "type": "integer",
              "minimum": 0
            },
            "ions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/DiagnosticIonShare"
              }
            },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string"
                  },
                  "ms2_spectra": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "ions": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/DiagnosticIonShare"
                    }
                  }
                },
                "required": [
                  "file",
                  "ms2_spectra",
                  "ions"
                ]
              }
            }
          },
          "required": [
            "ms2_spectra",
            "ions",
            "files"
          ]
        },
        "composition": {
          "type": "object",
          "description": "Headline numbers of the amino acid composition comparison; the per-residue rows are in qc.composition.tsv.",
          "properties": {
            "q_value": {
              "type": "number"
            },
            "files": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CompositionHeadline"
              }
            },
            "total": {
              "$ref": "#/$defs/CompositionHeadline"
            }
          },
          "required": [
            "q_value",
            "files",
            "total"
          ]
        },
        "chromatography": {
          "type": "object",
          "description": "Charge states, peak width and quantification counts per file; the same rows as qc.chromatography.tsv.",
          "properties": {
            "q_value": {
              "type": "number"
            },
            "files": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ChromatographyFileStats"
              }
            },
            "total": {
              "$ref": "#/$defs/ChromatographyStats"
            }
          },
          "required": [
            "q_value",
            "files",
            "total"
          ]
        },
        "modifications": {
          "type": "object",
          "description": "Present when the search has at least one variable modification. Same rows as qc.modifications.tsv.",
          "properties": {
            "q_value": {
              "type": "number"
            },
            "modifications": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ModificationOccupancy"
              }
            },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string"
                  },
                  "modifications": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/ModificationOccupancy"
                    }
                  }
                },
                "required": [
                  "file",
                  "modifications"
                ]
              }
            }
          },
          "required": [
            "q_value",
            "modifications",
            "files"
          ]
        }
      },
      "required": []
    },
    "output_paths": {
      "type": "array",
      "description": "Every artifact written, including run-summary.json.",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "software_version": {
          "type": "string"
        },
        "mzmlb_enabled": {
          "type": "boolean"
        },
        "input_identity_mode": {
          "type": "string"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "size_bytes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "modified_unix_secs": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            },
            "required": [
              "path",
              "size_bytes",
              "modified_unix_secs"
            ]
          }
        }
      },
      "required": [
        "software_version"
      ]
    },
    "recommended_tolerances": {
      "type": "object",
      "properties": {
        "psms": {
          "type": "integer",
          "minimum": 0
        },
        "precursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToleranceEstimate"
            },
            {
              "type": "null"
            }
          ]
        },
        "fragment": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToleranceEstimate"
            },
            {
              "type": "null"
            }
          ]
        },
        "skipped": {
          "type": "string",
          "description": "Why no recommendation was made."
        }
      },
      "required": [
        "psms",
        "precursor",
        "fragment"
      ]
    },
    "contaminants": {
      "type": "object",
      "description": "Contaminant proteins of `database.contaminant_fasta`; absent when none was searched. Counts are confident target PSMs at the run's 1% spectrum and peptide q-values.",
      "properties": {
        "path": {
          "type": "string",
          "description": "The searched contaminant FASTA."
        },
        "proteins": {
          "type": "integer",
          "minimum": 0,
          "description": "Proteins read from it."
        },
        "peptides": {
          "type": "integer",
          "minimum": 0,
          "description": "Database target peptides belonging to at least one contaminant protein."
        },
        "confident_psms": {
          "type": "integer",
          "minimum": 0
        },
        "contaminant_psms": {
          "type": "integer",
          "minimum": 0
        },
        "contaminant_psm_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "files": {
          "type": "array",
          "description": "The same per acquisition file.",
          "items": {
            "$ref": "#/$defs/ContaminantFileStats"
          }
        }
      }
    },
    "entrapment": {
      "type": "object",
      "description": "Entrapment proteins of `database.entrapment_fasta` and the false discovery proportion they estimate; absent when none was searched.",
      "properties": {
        "path": {
          "type": "string"
        },
        "entrapment_proteins": {
          "type": "integer",
          "minimum": 0
        },
        "target_proteins": {
          "type": "integer",
          "minimum": 0
        },
        "entrapment_peptides": {
          "type": "integer",
          "minimum": 0,
          "description": "Database target peptides whose every protein is an entrapment protein."
        },
        "target_peptides": {
          "type": "integer",
          "minimum": 0,
          "description": "The remaining database target peptides, including those a sample protein and an entrapment protein both explain."
        },
        "shared_peptides": {
          "type": "integer",
          "minimum": 0,
          "description": "Of `target_peptides`, how many an entrapment protein also explains."
        },
        "method": {
          "type": "string",
          "description": "The estimate's name, e.g. `combined (Wen et al. 2025, Nature Methods, eq. 1)`."
        },
        "psms": {
          "$ref": "#/$defs/EntrapmentEstimate"
        },
        "peptides": {
          "$ref": "#/$defs/EntrapmentEstimate"
        },
        "proteins": {
          "$ref": "#/$defs/EntrapmentEstimate"
        }
      }
    },
    "in_source": {
      "type": "object",
      "description": "In-source fragmentation and in-source neutral loss annotation; absent when `in_source` is off.",
      "properties": {
        "rt_tolerance": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Configured co-elution tolerance for the retention-time mode; absent when each file derived its own."
        },
        "flagged_psms": {
          "type": "integer",
          "minimum": 0,
          "description": "PSMs annotated as in-source products."
        },
        "modes": {
          "type": "array",
          "description": "The check per way of deciding co-elution: `apex` where quantification gave both the product and the parent a peak in the file and the PSM fired inside the product's peak, `rt` where PSM retention times were compared. The two are never pooled: a difference in peak widths is not a difference in minutes.",
          "items": {
            "$ref": "#/$defs/InSourceModeStats"
          }
        },
        "files": {
          "type": "array",
          "description": "Per-file record, including the difference histogram of each mode.",
          "items": {
            "$ref": "#/$defs/InSourceFileStats"
          }
        }
      }
    },
    "peak_rss_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Peak resident set size of the Sage process in bytes (Linux VmHWM, else getrusage ru_maxrss); null where unavailable.",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "runtime_secs",
    "files",
    "peptides_in_database",
    "fragments_in_database",
    "psms_at_one_percent_fdr",
    "peptides_at_one_percent_fdr",
    "proteins_at_one_percent_fdr",
    "protein_groups_at_one_percent_fdr",
    "output_paths"
  ],
  "$defs": {
    "ToleranceEstimate": {
      "type": "object",
      "properties": {
        "bias_ppm": {
          "type": "number",
          "description": "Median signed error (observed - theoretical), ppm."
        },
        "sigma_ppm": {
          "type": "number",
          "description": "Robust standard deviation (1.4826 x MAD), ppm."
        },
        "required_ppm": {
          "type": "number",
          "description": "|bias_ppm| + 4 x sigma_ppm."
        },
        "recommended_ppm": {
          "type": [
            "number",
            "null"
          ],
          "description": "Smallest of 5, 10, 20, 50 and 100 ppm covering required_ppm; null when even 100 ppm does not."
        }
      },
      "required": [
        "bias_ppm",
        "sigma_ppm",
        "required_ppm",
        "recommended_ppm"
      ]
    },
    "DigestionSummary": {
      "type": "object",
      "properties": {
        "target_peptides": {
          "type": "integer",
          "minimum": 0
        },
        "decoy_peptides": {
          "type": "integer",
          "minimum": 0
        },
        "peptides": {
          "type": "integer",
          "description": "Denominator: target minus decoy peptides.",
          "minimum": 0
        },
        "missed_cleavages_0": {
          "type": "integer",
          "minimum": 0
        },
        "missed_cleavages_1": {
          "type": "integer",
          "minimum": 0
        },
        "missed_cleavages_2_plus": {
          "type": "integer",
          "minimum": 0
        },
        "semi_n": {
          "type": "integer",
          "minimum": 0
        },
        "semi_c": {
          "type": "integer",
          "minimum": 0
        },
        "non_enzymatic": {
          "type": "integer",
          "minimum": 0
        },
        "missed_cleavage_pct": {
          "type": "number",
          "description": "Percent of peptides with at least one missed cleavage."
        },
        "semi_n_pct": {
          "type": "number"
        },
        "semi_c_pct": {
          "type": "number"
        },
        "non_enzymatic_pct": {
          "type": "number"
        }
      },
      "required": [
        "target_peptides",
        "decoy_peptides",
        "peptides",
        "missed_cleavages_0",
        "missed_cleavages_1",
        "missed_cleavages_2_plus",
        "semi_n",
        "semi_c",
        "non_enzymatic",
        "missed_cleavage_pct",
        "semi_n_pct",
        "semi_c_pct",
        "non_enzymatic_pct"
      ]
    },
    "DiagnosticIonShare": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "mz": {
          "type": "number"
        },
        "spectra": {
          "type": "integer",
          "description": "MS2 spectra containing the ion.",
          "minimum": 0
        },
        "spectra_pct": {
          "type": "number",
          "description": "Percent of MS2 spectra containing the ion."
        }
      },
      "required": [
        "name",
        "mz",
        "spectra",
        "spectra_pct"
      ]
    },
    "DigestionFileStats": {
      "allOf": [
        {
          "$ref": "#/$defs/DigestionSummary"
        },
        {
          "type": "object",
          "properties": {
            "file": {
              "type": "string"
            }
          },
          "required": [
            "file"
          ]
        }
      ]
    },
    "InSourceFileStats": {
      "type": "object",
      "description": "One acquisition file's in-source record.",
      "properties": {
        "file_id": {
          "type": "integer",
          "minimum": 0
        },
        "confident_psms": {
          "type": "integer",
          "minimum": 0
        },
        "flagged_psms": {
          "type": "integer",
          "minimum": 0
        },
        "median_fwhm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Median full width at half maximum of the file's quantified peaks, the width used where a peak's own is unknown; absent without quantification."
        },
        "modes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InSourceModeStats"
          }
        }
      }
    },
    "InSourceHistogramBin": {
      "type": "object",
      "properties": {
        "bin": {
          "type": "integer",
          "description": "Bin index: the bin is centred on `bin` times 0.05 of the mode's unit and is one bin wide, so bin 0 is centred on zero and bin -k mirrors bin k."
        },
        "start": {
          "type": "number"
        },
        "end": {
          "type": "number"
        },
        "pairs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "InSourcePlacementStats": {
      "type": "object",
      "description": "The in-source check for one placement of a product in its parent, or for all of them.",
      "properties": {
        "placement": {
          "type": "string",
          "enum": [
            "all",
            "same_span",
            "suffix",
            "prefix",
            "internal"
          ]
        },
        "candidate_pairs": {
          "type": "integer",
          "minimum": 0,
          "description": "Product/parent pairs that passed the sequence and mass test."
        },
        "coeluting_pairs": {
          "type": "integer",
          "minimum": 0,
          "description": "Candidate pairs inside the co-elution window."
        },
        "expected_by_chance": {
          "type": "number",
          "minimum": 0,
          "description": "Co-eluting pairs expected from the density of candidate pairs 1 to 5 units from zero, scaled to the window's width."
        },
        "flagged_psms": {
          "type": "integer",
          "minimum": 0
        },
        "outside_pairs": {
          "type": "integer",
          "minimum": 0,
          "description": "Candidate pairs further from zero than the histogram's half-width."
        },
        "rt_difference_histogram": {
          "type": "array",
          "description": "Differences of the candidate pairs on a fixed 0.05-unit grid, in the mode's unit.",
          "items": {
            "$ref": "#/$defs/InSourceHistogramBin"
          }
        }
      }
    },
    "InSourceModeStats": {
      "type": "object",
      "description": "The in-source check for one way of deciding co-elution.",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "apex",
            "rt"
          ],
          "description": "`apex` compares the two quantified peaks' apexes, `rt` the product's PSM retention time with the parent's median."
        },
        "unit": {
          "type": "string",
          "enum": [
            "peak_fwhm",
            "retention_time"
          ],
          "description": "`peak_fwhm`: a difference in widths of the narrower peak. `retention_time`: the file's own retention-time units."
        },
        "tolerance": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Co-elution tolerance in that unit; absent at the run level when the files used different ones."
        },
        "tolerance_source": {
          "type": "string",
          "enum": [
            "configured",
            "derived",
            "fallback",
            "peak_width"
          ],
          "description": "`peak_width` for the apex mode; absent at the run level when the files differ."
        },
        "totals": {
          "$ref": "#/$defs/InSourcePlacementStats"
        },
        "placements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InSourcePlacementStats"
          }
        }
      }
    },
    "ContaminantFileStats": {
      "type": "object",
      "description": "One acquisition file's contaminant share.",
      "properties": {
        "file_id": {
          "type": "integer",
          "minimum": 0
        },
        "filename": {
          "type": "string"
        },
        "confident_psms": {
          "type": "integer",
          "minimum": 0
        },
        "contaminant_psms": {
          "type": "integer",
          "minimum": 0
        },
        "contaminant_psm_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "EntrapmentEstimate": {
      "type": "object",
      "description": "One level's entrapment estimate: the discoveries of each class, the database size ratio r, and the combined estimate of the false discovery proportion.",
      "properties": {
        "target_discoveries": {
          "type": "integer",
          "minimum": 0,
          "description": "N_T, reported discoveries of original (sample) targets."
        },
        "entrapment_discoveries": {
          "type": "integer",
          "minimum": 0,
          "description": "N_E, reported discoveries of entrapment targets."
        },
        "database_ratio": {
          "type": "number",
          "minimum": 0,
          "description": "r, entrapment over original target database size in this level's units; absent when there were no original targets."
        },
        "estimated_fdp": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "N_E * (1 + 1/r) / (N_T + N_E), an upper bound on the false discovery proportion; absent when it is undefined."
        }
      }
    },
    "CompositionHeadline": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "description": "Spectrum file name, or `total`."
        },
        "observed_peptides": {
          "type": "integer",
          "description": "Distinct confident target peptide sequences."
        },
        "observed_residues": {
          "type": "integer",
          "description": "Interior residues counted in them."
        },
        "expected_peptides": {
          "type": "integer",
          "description": "Distinct database peptide sequences of the identified proteins."
        },
        "expected_residues": {
          "type": "integer",
          "description": "Interior residues counted in those."
        },
        "largest_shift_residue": {
          "type": "string",
          "description": "Residue whose observed share differs most from the expected one. Absent when no residue has a finite ratio."
        },
        "largest_shift_log2_ratio": {
          "type": "number",
          "description": "That residue's log2 ratio of observed to expected fraction."
        },
        "jensen_shannon_distance": {
          "type": "number",
          "description": "Distance between the whole profiles, 0 identical to 1 disjoint. Absent when either profile counted no residues."
        },
        "matched_observed_residues": {
          "type": "integer",
          "description": "Observed interior residues whose missed-cleavage class the database could match, which carry the weights of the expected profile."
        }
      },
      "required": [
        "file",
        "observed_peptides",
        "observed_residues",
        "expected_peptides",
        "expected_residues",
        "matched_observed_residues"
      ]
    },
    "ChromatographyStats": {
      "type": "object",
      "properties": {
        "confident_precursors": {
          "type": "integer",
          "description": "Rank-1 target PSMs at 1% spectrum and peptide q-value."
        },
        "charges": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "Counts at charge 1, 2, 3, and 4 or above, in that order."
        },
        "charge_unknown": {
          "type": "integer",
          "description": "Precursors whose charge the file did not state."
        },
        "peak_width": {
          "type": [
            "number",
            "null"
          ],
          "description": "Width in the file's retention-time unit; null when nothing could be measured."
        },
        "peak_width_kind": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "lfq_median_fwhm",
            "repeat_psm_spread",
            "repeat_psm_spread_fallback",
            null
          ],
          "description": "Which quantity peak_width is. Null for the total row, where widths in different files' units would not be comparable."
        },
        "quantified_precursors": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Precursors with an integrated MS1 intensity in this file; null without quantification."
        },
        "transferred_precursors": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Of those, the ones with no direct MS2 evidence in this file: match-between-runs transfers. Null without quantification."
        }
      },
      "required": [
        "confident_precursors",
        "charges",
        "charge_unknown"
      ]
    },
    "ChromatographyFileStats": {
      "type": "object",
      "description": "A ChromatographyStats with the file it belongs to.",
      "allOf": [
        {
          "$ref": "#/$defs/ChromatographyStats"
        }
      ],
      "properties": {
        "file": {
          "type": "string"
        }
      },
      "required": [
        "file"
      ]
    },
    "ModificationOccupancy": {
      "type": "object",
      "properties": {
        "site_rule": {
          "type": "string"
        },
        "mass": {
          "type": "number"
        },
        "name": {
          "type": "string"
        },
        "search_mode": {
          "type": "string",
          "enum": [
            "database",
            "mass_offset"
          ]
        },
        "peptidoforms": {
          "type": "integer",
          "minimum": 0
        },
        "modified_peptidoforms": {
          "type": "integer",
          "minimum": 0
        },
        "eligible_sites": {
          "type": "integer",
          "minimum": 0
        },
        "modified_sites": {
          "type": "integer",
          "minimum": 0
        },
        "occupancy_pct": {
          "type": "number"
        }
      },
      "required": [
        "site_rule",
        "mass",
        "search_mode",
        "peptidoforms",
        "modified_peptidoforms",
        "eligible_sites",
        "modified_sites",
        "occupancy_pct"
      ]
    }
  }
}
