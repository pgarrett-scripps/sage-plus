message schema {
    required byte_array library_entry_id (utf8);
    required int64 source_psm_id;
    required byte_array source_file (utf8);
    required byte_array source_spectrum (utf8);
    required byte_array modified_peptide (utf8);
    required byte_array proforma (utf8);
    required byte_array stripped_peptide (utf8);
    required byte_array proteins (utf8);
    required byte_array label_channel (utf8);
    required byte_array label_group (utf8);
    required byte_array label_reference (utf8);
    required int32 precursor_charge;
    required float precursor_neutral_mass;
    required float precursor_mz;
    required float retention_time_minutes;
    required float aligned_retention_time_minutes;
    required float ion_mobility;
    required float spectrum_q;
    required float peptide_q;
    required int32 supporting_psms;
    required byte_array fragment_type (utf8);
    required int32 fragment_ordinal;
    required int32 fragment_charge;
    required float neutral_loss;
    required float fragment_mz;
    required float relative_intensity;
}
