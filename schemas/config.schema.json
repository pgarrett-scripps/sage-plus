{
  "$defs": {
    "AlignmentMethod": {
      "oneOf": [
        {
          "const": "linear",
          "description": "Preserve Sage's existing ordinary least-squares alignment.",
          "type": "string"
        },
        {
          "const": "nonlinear",
          "description": "Robust outlier filtering followed by a monotone piecewise-linear warp.",
          "type": "string"
        }
      ]
    },
    "BrukerFrameWindowSplittingConfig": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "Quadrupole": {
              "$ref": "#/$defs/BrukerQuadWindowExpansionStrategy"
            }
          },
          "required": [
            "Quadrupole"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Window": {
              "$ref": "#/$defs/BrukerQuadWindowExpansionStrategy"
            }
          },
          "required": [
            "Window"
          ],
          "type": "object"
        }
      ]
    },
    "BrukerMS1CentoidingConfig": {
      "additionalProperties": false,
      "properties": {
        "ims_pct": {
          "format": "float",
          "type": "number"
        },
        "mz_ppm": {
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "mz_ppm",
        "ims_pct"
      ],
      "type": "object"
    },
    "BrukerProcessingConfig": {
      "additionalProperties": false,
      "properties": {
        "ms1": {
          "$ref": "#/$defs/BrukerMS1CentoidingConfig"
        },
        "ms2": {
          "$ref": "#/$defs/BrukerSpectrumConfig"
        }
      },
      "required": [
        "ms2",
        "ms1"
      ],
      "type": "object"
    },
    "BrukerQuadWindowExpansionStrategy": {
      "oneOf": [
        {
          "enum": [
            "None"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Even": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "Even"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "UniformMobility": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "maxItems": 2,
                  "minItems": 2,
                  "prefixItems": [
                    {
                      "format": "double",
                      "type": "number"
                    },
                    {
                      "format": "double",
                      "type": "number"
                    }
                  ],
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "type": "array"
            }
          },
          "required": [
            "UniformMobility"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "UniformScan": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "format": "uint",
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "format": "uint",
                  "minimum": 0,
                  "type": "integer"
                }
              ],
              "type": "array"
            }
          },
          "required": [
            "UniformScan"
          ],
          "type": "object"
        }
      ]
    },
    "BrukerSpectrumConfig": {
      "additionalProperties": false,
      "properties": {
        "frame_splitting_params": {
          "$ref": "#/$defs/BrukerFrameWindowSplittingConfig"
        },
        "spectrum_processing_params": {
          "$ref": "#/$defs/BrukerSpectrumProcessingConfig"
        }
      },
      "required": [
        "spectrum_processing_params",
        "frame_splitting_params"
      ],
      "type": "object"
    },
    "BrukerSpectrumProcessingConfig": {
      "additionalProperties": false,
      "properties": {
        "calibrate": {
          "type": "boolean"
        },
        "calibration_tolerance": {
          "format": "double",
          "type": "number"
        },
        "centroiding_window": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "smoothing_window": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "smoothing_window",
        "centroiding_window",
        "calibration_tolerance",
        "calibrate"
      ],
      "type": "object"
    },
    "DeisotopeConfig": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/DeisotopeSettings"
        }
      ]
    },
    "DeisotopeSettings": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "max_charge": {
          "default": null,
          "format": "uint8",
          "maximum": 255,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_envelope_peaks": {
          "default": 4,
          "format": "uint",
          "maximum": 4,
          "minimum": 2,
          "type": "integer"
        },
        "max_isotope_log2_ratio": {
          "default": 1.5,
          "format": "float",
          "minimum": 0.0,
          "type": "number"
        },
        "min_envelope_peaks": {
          "default": 2,
          "format": "uint",
          "maximum": 4,
          "minimum": 2,
          "type": "integer"
        },
        "min_score": {
          "default": 0.44999998807907104,
          "format": "float",
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "ppm_tolerance": {
          "default": 10.0,
          "format": "float",
          "minimum": 0.0,
          "type": "number"
        }
      },
      "type": "object"
    },
    "EnzymeBuilder": {
      "additionalProperties": false,
      "properties": {
        "c_terminal": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "cleave_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "max_len": {
          "description": "Maximum peptide length that will be fragmented",
          "format": "uint",
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "min_len": {
          "description": "Minimum peptide length that will be fragmented",
          "format": "uint",
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "missed_cleavages": {
          "description": "How many missed cleavages to use",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "restrict": {
          "type": [
            "string",
            "null"
          ]
        },
        "semi_enzymatic": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "IntegrationStrategy": {
      "enum": [
        "Apex",
        "Sum"
      ],
      "type": "string"
    },
    "IonMobilityFeatureSet": {
      "enum": [
        "basic",
        "physicochemical",
        "additive_ptm"
      ],
      "type": "string"
    },
    "IonMobilitySettings": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "description": "Disable ion-mobility prediction even when mobility observations are present.",
          "type": "boolean"
        },
        "features": {
          "$ref": "#/$defs/IonMobilityFeatureSet",
          "default": "basic",
          "description": "Sequence features used by the linear regression model."
        },
        "folds": {
          "default": 3,
          "description": "Number of peptide-grouped cross-validation folds.",
          "format": "uint",
          "maximum": 10,
          "minimum": 2,
          "type": "integer"
        },
        "min_training_psms": {
          "default": 200,
          "description": "Minimum number of high-confidence mobility observations required for fitting.",
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        },
        "ptm_regularization": {
          "default": 25.0,
          "description": "Ridge penalty for additive variable-PTM mobility offsets.",
          "format": "double",
          "minimum": 0.0,
          "type": "number"
        },
        "seed": {
          "default": 42,
          "description": "Seed used for deterministic peptide-level fold assignment.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "Isobaric": {
      "oneOf": [
        {
          "enum": [
            "Tmt6",
            "Tmt10",
            "Tmt11",
            "Tmt16",
            "Tmt18"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "User": {
              "items": {
                "format": "float",
                "type": "number"
              },
              "type": "array"
            }
          },
          "required": [
            "User"
          ],
          "type": "object"
        }
      ]
    },
    "Kind": {
      "enum": [
        "a",
        "b",
        "c",
        "x",
        "y",
        "z"
      ],
      "type": "string"
    },
    "LfqOptions": {
      "additionalProperties": false,
      "properties": {
        "combine_charge_states": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "integration": {
          "anyOf": [
            {
              "$ref": "#/$defs/IntegrationStrategy"
            },
            {
              "type": "null"
            }
          ]
        },
        "mbr": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "mobility_pct_tolerance": {
          "format": "float",
          "minimum": 0.0,
          "type": [
            "number",
            "null"
          ]
        },
        "peak_scoring": {
          "anyOf": [
            {
              "$ref": "#/$defs/PeakScoringStrategy"
            },
            {
              "type": "null"
            }
          ]
        },
        "peptide_q_value": {
          "format": "float",
          "maximum": 1.0,
          "minimum": 0.0,
          "type": [
            "number",
            "null"
          ]
        },
        "ppm_tolerance": {
          "format": "float",
          "minimum": 0.0,
          "type": [
            "number",
            "null"
          ]
        },
        "rt_pct_tolerance": {
          "format": "float",
          "minimum": 0.0,
          "type": [
            "number",
            "null"
          ]
        },
        "spectral_angle": {
          "format": "double",
          "maximum": 1.0,
          "minimum": 0.0,
          "type": [
            "number",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "NeutralLossMode": {
      "enum": [
        "optional",
        "required"
      ],
      "type": "string"
    },
    "OutputFilter": {
      "additionalProperties": false,
      "properties": {
        "psm_q_value": {
          "default": 0.10000000149011612,
          "description": "Maximum spectrum-level q-value written to the PSM and matched-fragment tables.",
          "format": "float",
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        }
      },
      "type": "object"
    },
    "PeakScoringStrategy": {
      "enum": [
        "RetentionTime",
        "SpectralAngle",
        "Intensity",
        "Hybrid"
      ],
      "type": "string"
    },
    "PtmLibrarySettings": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "strict": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "PtmLocalizationSettings": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "description": "Compute PTM site localization and write site-level reports.",
          "type": "boolean"
        },
        "localization_q_value": {
          "default": 0.009999999776482582,
          "description": "Arrangement-level false-localization-rate q-value cutoff.",
          "format": "float",
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "psm_q_value": {
          "default": 0.009999999776482582,
          "description": "Identification q-value cutoff for PSMs included in PTM site reports.",
          "format": "float",
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        }
      },
      "type": "object"
    },
    "QuantOptions": {
      "additionalProperties": false,
      "properties": {
        "lfq": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "lfq_settings": {
          "anyOf": [
            {
              "$ref": "#/$defs/LfqOptions"
            },
            {
              "type": "null"
            }
          ]
        },
        "tmt": {
          "anyOf": [
            {
              "$ref": "#/$defs/Isobaric"
            },
            {
              "type": "null"
            }
          ]
        },
        "tmt_settings": {
          "anyOf": [
            {
              "$ref": "#/$defs/TmtOptions"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "RetentionTimeFeatureSet": {
      "enum": [
        "basic",
        "physicochemical",
        "additive_ptm"
      ],
      "type": "string"
    },
    "RetentionTimeSettings": {
      "additionalProperties": false,
      "properties": {
        "features": {
          "$ref": "#/$defs/RetentionTimeFeatureSet",
          "default": "basic",
          "description": "Sequence features used by the linear regression model."
        },
        "folds": {
          "default": 3,
          "description": "Number of peptide-grouped cross-validation folds.",
          "format": "uint",
          "maximum": 10,
          "minimum": 2,
          "type": "integer"
        },
        "ptm_regularization": {
          "default": 25.0,
          "description": "Ridge penalty for additive variable-PTM retention-time offsets.",
          "format": "double",
          "minimum": 0.0,
          "type": "number"
        },
        "seed": {
          "default": 42,
          "description": "Seed used for deterministic peptide-level fold assignment.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "ScoreType": {
      "enum": [
        "SageHyperScore",
        "OpenMSHyperScore"
      ],
      "type": "string"
    },
    "SiteMode": {
      "description": "Controls where candidates for a variable modification are generated.",
      "oneOf": [
        {
          "const": "exhaustive",
          "description": "Generate the modification at every compatible site from the config.",
          "type": "string"
        },
        {
          "const": "library",
          "description": "Generate the modification only at sites listed in the PTM library.",
          "type": "string"
        },
        {
          "const": "both",
          "description": "Generate exhaustive candidates and allow library sites as targeted additions.",
          "type": "string"
        }
      ]
    },
    "SpectralLibraryFormat": {
      "enum": [
        "sage_parquet",
        "mzspeclib"
      ],
      "type": "string"
    },
    "SpectralLibrarySettings": {
      "additionalProperties": false,
      "description": "Settings for an empirical library built from confidently identified PSMs.",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "formats": {
          "default": [
            "sage_parquet",
            "mzspeclib"
          ],
          "items": {
            "$ref": "#/$defs/SpectralLibraryFormat"
          },
          "type": "array"
        },
        "include_chimeric": {
          "default": false,
          "type": "boolean"
        },
        "max_fragments": {
          "default": 20,
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        },
        "min_consensus_psms": {
          "default": 1,
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        },
        "min_fragment_frequency": {
          "default": 0.5,
          "format": "float",
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "min_matched_peaks": {
          "default": 6,
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "min_relative_intensity": {
          "default": 0.009999999776482582,
          "format": "float",
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "peptide_q_value": {
          "default": 0.009999999776482582,
          "format": "float",
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "psm_q_value": {
          "default": 0.009999999776482582,
          "format": "float",
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "strategy": {
          "$ref": "#/$defs/SpectralLibraryStrategy",
          "default": "best_psm"
        }
      },
      "type": "object"
    },
    "SpectralLibraryStrategy": {
      "enum": [
        "best_psm",
        "consensus"
      ],
      "type": "string"
    },
    "StaticModEntry": {
      "anyOf": [
        {
          "format": "float",
          "type": "number"
        },
        {
          "$ref": "#/$defs/StaticModification"
        }
      ]
    },
    "StaticModification": {
      "additionalProperties": false,
      "description": "A structured static modification. Numeric static modifications remain\nsupported through [`StaticModEntry::Mass`].",
      "properties": {
        "channel_offsets": {
          "additionalProperties": {
            "format": "float",
            "type": "number"
          },
          "type": "object"
        },
        "mass": {
          "format": "float",
          "type": "number"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "neutral_loss_mode": {
          "$ref": "#/$defs/NeutralLossMode"
        },
        "neutral_losses": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "type": "array"
        }
      },
      "required": [
        "mass"
      ],
      "type": "object"
    },
    "TmtOptions": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "sn": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Tolerance": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "ppm": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "format": "float",
                  "type": "number"
                },
                {
                  "format": "float",
                  "type": "number"
                }
              ],
              "type": "array"
            }
          },
          "required": [
            "ppm"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "pct": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "format": "float",
                  "type": "number"
                },
                {
                  "format": "float",
                  "type": "number"
                }
              ],
              "type": "array"
            }
          },
          "required": [
            "pct"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "da": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "format": "float",
                  "type": "number"
                },
                {
                  "format": "float",
                  "type": "number"
                }
              ],
              "type": "array"
            }
          },
          "required": [
            "da"
          ],
          "type": "object"
        }
      ]
    },
    "VarModEntry": {
      "anyOf": [
        {
          "format": "float",
          "type": "number"
        },
        {
          "$ref": "#/$defs/VariableModification"
        }
      ],
      "description": "A variable modification entry may use the existing bare-mass syntax or the\nextensible object syntax."
    },
    "VariableModification": {
      "additionalProperties": false,
      "description": "A variable modification with optional per-peptide occurrence limit and\noptional fragment neutral-loss behavior.",
      "properties": {
        "channel_offsets": {
          "additionalProperties": {
            "format": "float",
            "type": "number"
          },
          "type": "object"
        },
        "mass": {
          "format": "float",
          "type": "number"
        },
        "max_count": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "neutral_loss_mode": {
          "$ref": "#/$defs/NeutralLossMode"
        },
        "neutral_losses": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "type": "array"
        },
        "site_mode": {
          "$ref": "#/$defs/SiteMode"
        }
      },
      "required": [
        "mass"
      ],
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/pgarrett-scripps/sage-plus/main/schemas/config.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Input search parameters deserialized from JSON file",
  "properties": {
    "annotate_matches": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "batch_size": {
      "format": "uint",
      "minimum": 1,
      "type": [
        "integer",
        "null"
      ]
    },
    "bruker_config": {
      "anyOf": [
        {
          "$ref": "#/$defs/BrukerProcessingConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "chimera": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "database": {
      "additionalProperties": false,
      "description": "Parameters used for generating the fragment database",
      "properties": {
        "bucket_size": {
          "description": "Maximum number of theoretical fragments stored in one search bucket.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "custom_cleavage_sites": {
          "description": "Path to a protein-specific custom cleavage-site TSV or Parquet file.\nRequired columns: `protein`, `position`; optional column: `context`.",
          "type": [
            "string",
            "null"
          ]
        },
        "decoy_tag": {
          "description": "Use this prefix for decoy proteins",
          "type": [
            "string",
            "null"
          ]
        },
        "enzyme": {
          "anyOf": [
            {
              "$ref": "#/$defs/EnzymeBuilder"
            },
            {
              "type": "null"
            }
          ]
        },
        "fasta": {
          "description": "Path to fasta database",
          "type": [
            "string",
            "null"
          ]
        },
