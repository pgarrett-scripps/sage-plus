{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/pgarrett-scripps/sage-plus/main/schemas/config.schema.json",
  "title": "Sage search configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["precursor_tol", "fragment_tol"],
  "oneOf": [
    { "required": ["database"], "not": { "required": ["library_search"] } },
    { "required": ["library_search"], "not": { "required": ["database"] } }
  ],
  "properties": {
    "database": { "$ref": "#/$defs/database" },
    "library_search": { "type": "object", "additionalProperties": true },
    "precursor_tol": { "$ref": "#/$defs/tolerance" },
    "fragment_tol": { "$ref": "#/$defs/tolerance" },
    "report_psms": { "type": "integer", "minimum": 1, "default": 1 },
    "output_filter": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "psm_q_value": { "$ref": "#/$defs/qValue" } }
    },
    "chimera": { "type": "boolean", "default": false },
    "wide_window": { "type": "boolean", "default": false },
    "min_peaks": { "type": "integer", "minimum": 1 },
    "max_peaks": { "type": "integer", "minimum": 1 },
    "max_fragment_charge": { "type": "integer", "minimum": 1, "maximum": 255 },
    "min_matched_peaks": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "precursor_charge": { "$ref": "#/$defs/u8Range" },
    "override_precursor_charge": { "type": "boolean" },
    "isotope_errors": { "$ref": "#/$defs/i8Range" },
    "deisotope": { "type": "boolean" },
    "quant": { "$ref": "#/$defs/quant" },
    "predict_rt": { "type": "boolean", "default": true },
    "retention_time_model": { "$ref": "#/$defs/retentionModel" },
    "retention_time_alignment": {
      "type": "string",
      "enum": ["linear", "nonlinear"]
    },
    "ion_mobility_model": { "$ref": "#/$defs/mobilityModel" },
    "output_directory": { "type": "string" },
    "mzml_paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "bruker_config": { "type": "object", "additionalProperties": true },
    "protein_grouping": { "type": "boolean", "default": true },
    "protein_grouping_peptide_fdr": { "$ref": "#/$defs/qValue" },
    "max_memory_gb": { "type": "number", "minimum": 0 },
    "min_free_memory_gb": { "type": "number", "minimum": 0 },
    "batch_size": { "type": "integer", "minimum": 1 },
    "ptm_localization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "psm_q_value": { "$ref": "#/$defs/qValue" },
        "q_value": { "$ref": "#/$defs/qValue", "deprecated": true },
        "localization_q_value": { "$ref": "#/$defs/qValue" }
      }
    },
    "spectral_library": { "type": "object", "additionalProperties": true },
    "mass_shift_ppm": { "type": "number", "minimum": 0 },
    "annotate_matches": { "type": "boolean" },
    "write_pin": { "type": "boolean" },
    "write_report": { "type": "boolean" },
    "score_type": {
      "type": "string",
      "enum": ["SageHyperScore", "OpenMSHyperScore"]
    }
  },
  "$defs": {
    "qValue": { "type": "number", "minimum": 0, "maximum": 1 },
    "u8Range": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": 0, "maximum": 255 },
        { "type": "integer", "minimum": 0, "maximum": 255 }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "i8Range": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": -128, "maximum": 127 },
        { "type": "integer", "minimum": -128, "maximum": 127 }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "tolerance": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "ppm": { "$ref": "#/$defs/numberRange" },
        "da": { "$ref": "#/$defs/numberRange" },
        "pct": { "$ref": "#/$defs/numberRange" }
      }
    },
    "numberRange": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "minItems": 2,
      "maxItems": 2
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bucket_size": { "type": "integer", "minimum": 1 },
        "enzyme": { "$ref": "#/$defs/enzyme" },
        "peptide_min_mass": { "type": "number", "minimum": 0 },
        "peptide_max_mass": { "type": "number", "minimum": 0 },
        "fragment_min_mz": { "type": "number", "minimum": 0, "deprecated": true },
        "fragment_max_mz": { "type": "number", "minimum": 0, "deprecated": true },
        "ion_kinds": {
          "type": "array",
          "items": { "type": "string", "enum": ["a", "b", "c", "x", "y", "z"] }
        },
        "min_ion_index": { "type": "integer", "minimum": 0 },
        "static_mods": { "$ref": "#/$defs/modificationMap" },
        "variable_mods": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/$defs/modification" }
          }
        },
        "max_variable_mods": { "type": "integer", "minimum": 1 },
        "max_combinations": { "type": "integer", "minimum": 1 },
        "max_total_variable_mods": { "type": "integer", "minimum": 1 },
        "ptm_library": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "path": { "type": "string" },
            "strict": { "type": "boolean", "default": true }
          }
        },
        "decoy_tag": { "type": "string", "default": "rev_" },
        "decoy_prefix": { "type": "string", "deprecated": true },
        "generate_decoys": { "type": "boolean", "default": true },
        "fasta": { "type": "string" },
        "peptides": { "type": "string" },
        "custom_cleavage_sites": { "type": "string" },
        "prefilter_chunk_size": { "type": "integer", "minimum": 0 },
        "prefilter": { "type": "boolean", "default": false },
        "prefilter_low_memory": { "type": "boolean", "default": true }
      }
    },
    "enzyme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "missed_cleavages": { "type": "integer", "minimum": 0, "maximum": 255 },
        "min_len": { "type": "integer", "minimum": 1 },
        "max_len": { "type": "integer", "minimum": 1 },
        "cleave_at": { "type": "string" },
        "restrict": { "type": "string" },
        "c_terminal": { "type": "boolean" },
        "semi_enzymatic": { "type": "boolean" }
      }
    },
    "modificationMap": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/modification" }
    },
    "modification": {
      "oneOf": [
        { "type": "number" },
        {
          "type": "object",
          "required": ["mass"],
          "additionalProperties": true,
          "properties": {
            "mass": { "type": "number" },
            "name": { "type": "string" },
            "max_count": { "type": "integer", "minimum": 1 },
            "channel_offsets": {
              "type": "object",
              "additionalProperties": { "type": "number" },
              "minProperties": 2
            }
          }
        }
      ]
    },
    "quant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tmt": { "type": ["string", "null"] },
        "tmt_settings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "level": { "type": "integer", "minimum": 1, "maximum": 255 },
            "sn": { "type": "boolean" }
          }
        },
        "lfq": { "type": "boolean", "default": false },
        "lfq_settings": { "$ref": "#/$defs/lfq" }
      }
    },
    "lfq": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "peak_scoring": { "type": "string", "enum": ["RetentionTime", "SpectralAngle", "Intensity", "Hybrid"] },
        "integration": { "type": "string", "enum": ["Apex", "Sum"] },
        "spectral_angle": { "type": "number", "minimum": 0, "maximum": 1 },
        "ppm_tolerance": { "type": "number", "exclusiveMinimum": 0 },
        "rt_pct_tolerance": { "type": "number", "exclusiveMinimum": 0 },
        "mobility_pct_tolerance": { "type": "number", "exclusiveMinimum": 0 },
        "combine_charge_states": { "type": "boolean" },
        "peptide_q_value": { "$ref": "#/$defs/qValue" },
        "mbr": { "type": "boolean", "default": true }
      }
    },
    "retentionModel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "features": { "type": "string", "enum": ["basic", "physicochemical", "additive_ptm"] },
        "folds": { "type": "integer", "minimum": 2, "maximum": 10 },
        "seed": { "type": "integer", "minimum": 0 },
        "ptm_regularization": { "type": "number", "minimum": 0 }
      }
    },
    "mobilityModel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "features": { "type": "string", "enum": ["basic", "physicochemical", "additive_ptm"] },
        "folds": { "type": "integer", "minimum": 2, "maximum": 10 },
        "seed": { "type": "integer", "minimum": 0 },
        "ptm_regularization": { "type": "number", "minimum": 0 },
        "min_training_psms": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
