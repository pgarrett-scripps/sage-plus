message schema {
    required byte_array peptide (utf8);
    required byte_array stripped_peptide (utf8);
    optional int32 charge;
    required byte_array proteins (utf8);
    required boolean is_decoy;
    required float q_value;
    required double score;
    required double spectral_angle;
    required byte_array filename (utf8);
    optional double intensity;
    required boolean ms2_confirmed;
    required boolean ms2_confirmed_strict;
    optional double file_score;
    optional double file_spectral_angle;
    optional double file_trace_cosine;
    optional int32 file_rt_shift_bins;
    optional boolean transfer_candidate;
}
